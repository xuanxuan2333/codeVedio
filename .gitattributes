# 默认按文本处理，仓库里统一 LF；Windows 检出后脚本也不会变成 CRLF
* text=auto eol=lf

# 二进制，别做换行转换，也别让 git 尝试 diff
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.aiff binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 文档和脚本显式 LF
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sh text eol=lf
